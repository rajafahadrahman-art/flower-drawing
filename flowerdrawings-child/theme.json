{
	"$schema": "https://schemas.wp.org/wp/6.5/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"border": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		},
		"color": {
			"custom": true,
			"customDuotone": false,
			"customGradient": false,
			"defaultDuotone": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"palette": [
				{
					"slug": "ink",
					"name": "Ink",
					"color": "#111111"
				},
				{
					"slug": "background",
					"name": "Background",
					"color": "#ffffff"
				},
				{
					"slug": "surface",
					"name": "Surface",
					"color": "#f6f6f3"
				},
				{
					"slug": "surface-strong",
					"name": "Surface Strong",
					"color": "#ecece7"
				},
				{
					"slug": "border",
					"name": "Border",
					"color": "#d8d8d2"
				},
				{
					"slug": "muted",
					"name": "Muted",
					"color": "#64645f"
				},
				{
					"slug": "sage-light",
					"name": "Sage Light",
					"color": "#e4eee5"
				},
				{
					"slug": "sage",
					"name": "Sage",
					"color": "#819a89"
				},
				{
					"slug": "blush-light",
					"name": "Blush Light",
					"color": "#f6e2de"
				},
				{
					"slug": "blush",
					"name": "Blush",
					"color": "#d98278"
				}
			]
		},
		"custom": {
			"layout": {
				"headerHeight": "72px"
			},
			"shadow": {
				"small": "0 1px 2px rgba(17, 17, 17, 0.04), 0 8px 24px rgba(17, 17, 17, 0.04)",
				"medium": "0 12px 38px rgba(17, 17, 17, 0.08)",
				"large": "0 18px 60px rgba(17, 17, 17, 0.10)"
			}
		},
		"layout": {
			"contentSize": "760px",
			"wideSize": "1240px"
		},
		"spacing": {
			"blockGap": "1.5rem",
			"customSpacingSize": true,
			"spacingScale": {
				"operator": "*",
				"increment": 1.5,
				"steps": 6,
				"mediumStep": 1.5,
				"unit": "rem"
			},
			"units": [
				"px",
				"rem",
				"em",
				"vw",
				"vh",
				"%"
			]
		},
		"typography": {
			"customFontSize": true,
			"defaultFontSizes": false,
			"dropCap": false,
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "system-sans",
					"name": "System Sans",
					"fontFamily": "ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, \"Noto Sans\", sans-serif"
				},
				{
					"slug": "system-serif",
					"name": "System Serif",
					"fontFamily": "ui-serif, Georgia, Cambria, \"Times New Roman\", Times, serif"
				}
			],
			"fontSizes": [
				{
					"slug": "small",
					"name": "Small",
					"size": "clamp(0.88rem, 0.84rem + 0.2vw, 1rem)"
				},
				{
					"slug": "medium",
					"name": "Medium",
					"size": "clamp(1rem, 0.96rem + 0.2vw, 1.1rem)"
				},
				{
					"slug": "large",
					"name": "Large",
					"size": "clamp(1.22rem, 1.06rem + 0.78vw, 1.66rem)"
				},
				{
					"slug": "x-large",
					"name": "Extra Large",
					"size": "clamp(1.55rem, 1.24rem + 1.5vw, 2.42rem)"
				},
				{
					"slug": "xx-large",
					"name": "Huge",
					"size": "clamp(2.05rem, 1.48rem + 2.8vw, 3.75rem)"
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|background",
			"text": "var:preset|color|ink"
		},
		"spacing": {
			"blockGap": "1.5rem"
		},
		"typography": {
			"fontFamily": "var:preset|font-family|system-sans",
			"lineHeight": "1.68"
		},
		"elements": {
			"button": {
				"border": {
					"radius": "999px"
				},
				"typography": {
					"fontWeight": "760"
				}
			},
			"heading": {
				"color": {
					"text": "var:preset|color|ink"
				},
				"typography": {
					"fontFamily": "var:preset|font-family|system-sans",
					"fontWeight": "680",
					"letterSpacing": "-0.035em",
					"lineHeight": "1.16"
				}
			},
			"link": {
				"color": {
					"text": "var:preset|color|ink"
				}
			}
		}
	}
}
